\begin{enumerate}
\item \textbf{Assumptions:}
\begin{itemize}
  \item \textbf{QDA:} Gaussian class-conditionals $\xv | y = k \sim \normal(\muk, \Sigma_k)$, where each class has its own mean vector $\muk$ and covariance matrix $\Sigma_k$; no feature independence assumed. As the $\Sigma_k$ can differ between classes, decision boundaries are quadratic.
  \item \textbf{LDA:} special case of QDA with class-specific $\muk$ but shared covariance matrix $\Sigma_k = \Sigma$ for all $k$, resulting in linear decision boundaries.
  \item \textbf{NB:} conditional independence of the features given the class:
  $$\pdfxyk = \prodjp p(x_j | y = k)$$
  With a univariate Gaussian per feature (Gaussian NB), this is a special case of QDA with diagonal covariance matrices $\Sigma_k = \diag(\sigma_{k1}^2, \ldots, \sigma_{kp}^2)$: variances may differ, all covariances are zero.
\end{itemize}

\item \textbf{Assignment:} A is QDA (most general, class-specific $\Sigma_k$); B and C are LDA and Gaussian NB (either way round), both special cases of A:
\begin{itemize}
  \item A $\to$ LDA: shared $\Sigma_k = \Sigma$ for all $k$.
  \item A $\to$ NB: diagonal $\Sigma_k = \diag(\sigma_{k1}^2, \ldots, \sigma_{kp}^2)$.
  \item Intersection of LDA and NB: shared \textbf{and} diagonal, $\Sigma_k = \Sigma = \diag(\sigma_1^2, \ldots, \sigma_p^2)$ for all $k$.
\end{itemize}

\item \textbf{Specific assumption:} the class-conditional distributions are Gaussian. NB can also be used with other (non-Gaussian) feature distributions; then NB is no longer a subset of QDA and its region would partly lie outside of A.
\end{enumerate}
