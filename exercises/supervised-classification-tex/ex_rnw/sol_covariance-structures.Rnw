The plot titles show which classifiers can model each case; the table gives the reasons.

<<covariance-structures-sol, echo = FALSE, message = FALSE, warning = FALSE, fig.width = 10, fig.height = 1.65, out.width = "\\textwidth">>=
source("../rsrc/covariance-structures.R")
titles = c("Case 1: LDA, QDA", "Case 2: QDA", "Case 3: LDA, QDA, NB", "Case 4: QDA, NB", "Case 5: QDA, NB")
wrap_plots(plot_cov_cases(titles), nrow = 1L)
@

\begin{tabular}{|c|c|l|l|p{7.3cm}|}
\hline
\textbf{Case} & \textbf{$\Sigma_1$, $\Sigma_2$} & \textbf{Can model} & \textbf{Cannot} & \textbf{Why} \\
\hline
\rule[-3.4ex]{0pt}{8ex}1 & $\Sigma_1 = \Sigma_2 = \begin{pmatrix} 2 & 1 \\ 1 & 2 \end{pmatrix}$ & LDA, QDA & NB & \raggedright Shared but non-diagonal $\Sigma$ (correlation): linear boundary; NB cannot model correlation. \tabularnewline
\hline
\rule[-3.4ex]{0pt}{8ex}2 & $\begin{pmatrix} 3 & 2 \\ 2 & 3 \end{pmatrix}$, $\begin{pmatrix} 3 & -2 \\ -2 & 2 \end{pmatrix}$ & QDA & LDA, NB & \raggedright Different full $\Sigma_k$ (different correlation): quadratic boundary with cross-term $x_1 x_2$; only QDA allows class-specific full $\Sigma_k$. \tabularnewline
\hline
\rule[-3.4ex]{0pt}{8ex}3 & $\Sigma_1 = \Sigma_2 = \begin{pmatrix} 1 & 0 \\ 0 & 1 \end{pmatrix}$ & LDA, QDA, NB & -- & \raggedright Shared and spherical $\Sigma_k = \Sigma = \id$: all assumptions hold, linear boundary. \tabularnewline
\hline
\rule[-3.4ex]{0pt}{8ex}4 & $\begin{pmatrix} 1 & 0 \\ 0 & 1 \end{pmatrix}$, $\begin{pmatrix} 3 & 0 \\ 0 & 3 \end{pmatrix}$ & QDA, NB & LDA & \raggedright Spherical but different scales ($\Sigma_2 = 3 \Sigma_1$): axis-aligned quadratic boundary (a circle); LDA needs a shared $\Sigma$. \tabularnewline
\hline
\rule[-3.4ex]{0pt}{8ex}5 & $\begin{pmatrix} 1 & 0 \\ 0 & 2 \end{pmatrix}$, $\begin{pmatrix} 3 & 0 \\ 0 & 1 \end{pmatrix}$ & QDA, NB & LDA & \raggedright Diagonal (no correlation) but elongated along different axes: axis-aligned quadratic boundary; LDA needs a shared $\Sigma$. \tabularnewline
\hline
\end{tabular}
